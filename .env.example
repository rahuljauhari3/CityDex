# CityDex environment variables.
# Copy this file to `.env.local` and fill in the values you have.
# The app runs end to end in DEMO mode with NO keys set — see README.md.
# Never commit `.env.local`.

# --- Supabase (optional; omit to use the in-memory demo store) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (optional; omit to use the deterministic mock stamp card) ---
ANTHROPIC_API_KEY=

# --- Strava OAuth (optional; P1 provider) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- WHOOP OAuth (optional; P2 provider) ---
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# --- Fitbit Web API (optional; P2 provider) ---
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

# --- App ---
APP_URL=http://localhost:3000

# Keep DEMO_MODE=true for the hackathon demo (seeds demo users + demo health
# provider, mock AI card when ANTHROPIC_API_KEY is absent).
DEMO_MODE=true
